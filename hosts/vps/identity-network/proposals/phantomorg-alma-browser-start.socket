[Unit]
Description=Fixed Alma browser-start control socket (proposal)

[Socket]
ListenStream=/run/phantomorg/alma-browser-start.sock
SocketUser=root
SocketGroup=pb-alma
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=4
MaxConnectionsPerSource=2
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
